# Python lock files from other tools
poetry.lock
Pipfile.lock

# Local logging artifacts, keep the source folder only
local_logging_audit/audit_log/*
!local_logging_audit/audit_log/.gitkeep
local_logging_dashboard/dashboard.html
local_telemetry/*.jsonl

# Local Chroma vector stores (rebuildable; HNSW bins exceed Git size limits)
vector_stores/**
!vector_stores/facts_chroma/
!vector_stores/facts_chroma/source_catalog.json

# Local experiment notes
EXP.txt
